# ==============================================================================
# 2. ENTRYPOINT -> LOCKED DAEMON SERVICES (One-way px -> transition)
# ==============================================================================

# --- PostgreSQL ---
profile podman-postgres flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  signal,
  file rwlkm,
  deny /proc/sys/** w,
  deny /sys/** w,

  /usr/local/bin/docker-entrypoint.sh ix,
  /bin/* ix,
  /usr/bin/* ix,
  /usr/local/bin/* ix,
  /sbin/* ix,
  /usr/sbin/* ix,

  # Transition to locked daemon profile (blocks all shells after startup)
  /usr/local/bin/postgres px -> podman-postgres-daemon,
  /usr/bin/postgres px -> podman-postgres-daemon,
}

profile podman-postgres-daemon flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  signal (send,receive) peer=@{profile_name},
  signal (receive) peer=podman-postgres,
  signal (receive) peer=unconfined,
  file rwlkm,
  deny /proc/sys/** w,
  deny /proc/{kcore,mem,kmem} rwklx,
  deny /sys/** w,
  deny mount,
  deny umount,

  /usr/local/bin/postgres ix,
  /usr/bin/postgres ix,
}

