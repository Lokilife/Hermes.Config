abi <abi/4.0>,
#include <tunables/global>

# ==============================================================================
# 1. DIRECT-BINARY SERVICES (No shell allowed at any stage)
# ==============================================================================

profile podman-meili flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  signal (send,receive) peer=@{profile_name},
  signal (receive) peer=unconfined,

  # Allow non-execute file operations (read, write, link, lock, mmap .so)
  file rwlkm,

  # Protect sensitive host /proc and /sys interfaces
  deny /proc/sys/** w,
  deny /proc/{kcore,mem,kmem} rwklx,
  deny /sys/** w,
  deny mount,
  deny umount,

  # ONLY allow Meilisearch itself to execute
  /bin/meilisearch ix,
  /usr/local/bin/meilisearch ix,
}

